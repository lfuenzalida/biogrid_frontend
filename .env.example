# Firebase Web SDK
# Obtén estos valores desde Firebase Console > Configuración del proyecto > Tus apps.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Opcional durante la etapa de monitoreo de App Check. Debe ser una site key
# de reCAPTCHA Enterprise, nunca una clave secreta.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=your_recaptcha_enterprise_site_key

# Activa la verificación de App Check en los Route Handlers. Habilítala solo
# después de revisar métricas en Firebase Console y configurar la site key.
FIREBASE_APP_CHECK_REQUIRED=false

# BioGrid Backend
# URL base sin slash final. Ejemplo local: http://localhost:8000
BIOGRID_API_URL=https://api.example.com

# Clave utilizada únicamente por los Route Handlers del servidor Next.js.
# No agregues el prefijo NEXT_PUBLIC_ a esta variable.
BIOGRID_API_KEY=your_biogrid_server_api_key

# Rate limiting distribuido del proxy de avistamientos (Upstash Redis REST).
# Son secretos de servidor. Producción falla de forma segura si no existen.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
