{
  "name": "biogrid-front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && npm run test:e2e:ci",
    "test:e2e:ci": "start-server-and-test \"npm run start -- --hostname 127.0.0.1 --port 3100\" http://127.0.0.1:3100/login \"playwright test\"",
    "quality": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "firebase": "^12.17.1",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-map-gl": "^8.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.40",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^3.4.7",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
